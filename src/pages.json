{
  "easycom": {
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/tab/home/index",
      "style": {
        "navigationBarTitleText": "首页",
        // 触底加载
        "onReachBottomDistance": 150
      }
    },
    {
      "path": "pages/tab/list/index",
      "style": {
        "navigationBarTitleText": "列表"
      }
    },
    {
      "path": "pages/tab/user/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/tab/cart/index",
      "style": {
        "navigationBarTitleText": "购物车",
        // 触底加载
        "onReachBottomDistance": 150
      }
    },
    {
      "path": "pages/product/detail/index",
      "style": {
        "navigationBarTitleText": "商品详情"
      }
    },
    {
      "path": "pages/address/index",
      "style": {
        "navigationBarTitleText": "收货地址"
      }
    },
    {
      "path": "pages/order/index",
      "style": {
        "navigationBarTitleText": "订单列表",
        // 触底加载
        "onReachBottomDistance": 150
      }
    },
    {
      "path": "pages/confirm/index",
      "style": {
        "navigationBarTitleText": "订单确认"
      }
    },
    {
      "path": "pages/pendding/index",
      "style": {
        "navigationBarTitleText": "待支付",
        // 触底加载
        "onReachBottomDistance": 150
      }
    }
  ],
  "tabBar": {
    "color": "#1b233b",
    "selectedColor": "#4F95FF",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "iconPath": "static/images/tabbar/icon_home.png",
        "selectedIconPath": "static/images/tabbar/icon_home_selected.png",
        "pagePath": "pages/tab/home/index",
        "text": "首页"
      },
      {
        "iconPath": "static/images/tabbar/icon_list.png",
        "selectedIconPath": "static/images/tabbar/icon_list_selected.png",
        "pagePath": "pages/tab/list/index",
        "text": "列表"
      },
      {
        "iconPath": "static/images/tabbar/icon_cart.png",
        "selectedIconPath": "static/images/tabbar/icon_cart_selected.png",
        "pagePath": "pages/tab/cart/index",
        "text": "购物车"
      },
      {
        "iconPath": "static/images/tabbar/icon_me.png",
        "selectedIconPath": "static/images/tabbar/icon_me_selected.png",
        "pagePath": "pages/tab/user/index",
        "text": "我的"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarBackgroundColor": "#ffffff",
    // "backgroundColor": "#F8F8F8"
  }
}